# ================================================================
#  >>> Central LLM config for Experiments 2 & 3 (and the control). <<<
#
#  This is the ONE place to change the model. Nothing else.
#  run.sh and run_all.sh source this file and export it, so it OVERRIDES
#  whatever is in the per-experiment infra/.env files.
#
#  Works with ANY OpenAI-compatible provider WITHOUT an API key.
# ================================================================

# 1) Model name, exactly as the provider expects it.
LLM_MODEL=gemma4:cloud

# 2) Provider base URL (NO trailing /v1). Pick / adjust one:
#      Ollama:     http://host.docker.internal:11434
#      vLLM:       http://<host-or-ip>:8000
#      LM Studio:  http://host.docker.internal:1234
#      llama.cpp:  http://host.docker.internal:8080
LLM_UPSTREAM=http://host.docker.internal:11434
