# Ports of necessary services
PRESIDIO_MOCK_PORT=5002
LLM_MOCK_PORT=5005
PROXY_PORT=8080

# SHA256 Hash value of dev image in ghcr.io of PrivacyProxy
# e.g. e575311e9cbd9a4d0f51f5afa2fd07f97907f22e
PRIVACYPROXY_IMAGE_TAG=<HASH>

# SampleSize PER LANGUAGE
SAMPLE_SIZE=200000

# Languages that are analysed
LANGUAGES=de,en

# HuggingFace Token needed for faster downlaod of dataset
HF_TOKEN=
