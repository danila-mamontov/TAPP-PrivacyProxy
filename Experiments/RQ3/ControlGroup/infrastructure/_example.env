# One config for everything: docker-compose reads it for the ${...} port variables,
# experiment.py and mcp_server.py load it via python-dotenv.

# --- Host ports (published by docker-compose) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
CALDAV_PORT=5232
CALENDAR_VIEWER_PORT=8090
TOOLS_PORT=3100

# --- Calendar name in Radicale ---
CALDAV_CAL=exp_rq3_controlgroup

# --- OpenClaw (external: the gateway container experiment.py talks to) ---
OPENCLAW_CONTAINER=openclaw-openclaw-gateway-1

# --- Experiment defaults (overridable per run, e.g. ITERATIONS=5 python3 experiment.py) ---
GROUP=exp-rq2-controlgroup
ITERATIONS=1
AGENT_TIMEOUT=180
MODEL=llm-direct/kimi-k2.6:cloud

# --- mcp_server.py when started on the HOST (python3 mcp_server.py) ---
# The server talks to the containers through their PUBLISHED ports, so from the
# host everything is "localhost". If the server later runs INSIDE the compose
# network, the compose "environment:" section overrides these with the service
# names (mailpit/radicale) - load_dotenv never overrides existing variables.
SMTP_HOST=localhost
SMTP_PORT=1025
CALDAV_URL=http://localhost:5232/
MAILPIT_API=http://localhost:8025
