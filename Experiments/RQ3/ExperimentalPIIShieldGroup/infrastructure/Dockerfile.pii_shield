FROM python:3.12-slim

ARG PII_SHIELD_REF=3730e54943a9844780652b8ce50cd588ca9e0cba

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends git build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN git clone https://github.com/KasamShaikh/pii-shield.git /app/pii-shield \
    && cd /app/pii-shield \
    && git checkout ${PII_SHIELD_REF}

WORKDIR /app/pii-shield

RUN pip install --no-cache-dir -r requirements.txt \
    && python -m spacy download en_core_web_lg

EXPOSE 8000

# PII Shield's REST session store is in-process, so use one worker to guarantee
# that the /anonymize_unique -> /deanonymize session stays on the same process.
CMD ["sh", "-c", "exec gunicorn app.main:app --worker-class uvicorn.workers.UvicornWorker --workers 1 --bind 0.0.0.0:8000 --preload"]
