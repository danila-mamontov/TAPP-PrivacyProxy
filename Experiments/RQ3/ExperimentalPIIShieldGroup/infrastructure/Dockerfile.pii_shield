FROM python:3.12-slim

ARG PII_SHIELD_REF=3730e54943a9844780652b8ce50cd588ca9e0cba
ARG SPACY_MODEL=en_core_web_lg

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends git build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN git clone https://github.com/KasamShaikh/pii-shield.git /app/pii-shield \
    && cd /app/pii-shield \
    && git checkout ${PII_SHIELD_REF} \
    && sed -i 's/^SPACY_MODEL = "en_core_web_lg"$/SPACY_MODEL = os.getenv("SPACY_MODEL", "en_core_web_lg")/' pii_shield/nlp_engine.py \
    && pip install --no-cache-dir -r requirements.txt \
    && python -m spacy download ${SPACY_MODEL}

ENV SPACY_MODEL=${SPACY_MODEL}

WORKDIR /app/pii-shield
EXPOSE 8000

# Keep one worker: the Shield session store is process-local/Redis-backed and each
# anonymize -> deanonymize pair must remain on one service instance.
CMD ["sh", "-c", "exec gunicorn app.main:app --worker-class uvicorn.workers.UvicornWorker --workers 1 --bind 0.0.0.0:8000 --preload"]
