# Host ports for the PII Shield RQ3 stack. They are intentionally separate from
# the TAPP RQ3 stack so both can be started during RQ4 without port collisions.
MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026
CALDAV_PORT=5233
CALENDAR_VIEWER_PORT=8091
TOOLS_PORT=3101
RECORDER_PORT=8001
PII_SHIELD_PORT=8010
PROXY_PORT=8081

CALDAV_CAL=exp_rq3_experimentalpiishieldgroup
OPENCLAW_CONTAINER=openclaw-openclaw-gateway-1

GROUP=exp-rq3-experimentalpiishieldgroup
ITERATIONS=5
AGENT_TIMEOUT=180

# The runner enforces exactly 7 unique :cloud models. It first looks for a
# 'piishield' provider in ~/.openclaw/openclaw.json, and otherwise uses MODELS.
# Set MODELS only when the seven IDs cannot be recovered from the OpenClaw config.
# MODELS=model1:cloud,model2:cloud,...,model7:cloud

# PII Shield itself is the middleware; the model ID is sent unchanged upstream.
LLM_BASE_URL=http://host.docker.internal:11434
PII_SHIELD_LANGUAGE_MODE=force_en
PII_SHIELD_REQUEST_TIMEOUT=120

# Pinned upstream PII Shield source.
PII_SHIELD_REF=3730e54943a9844780652b8ce50cd588ca9e0cba
