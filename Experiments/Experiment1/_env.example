# Copy this file to ".env" and adjust it. ".env" itself is gitignored.

# --- Host ports (how you / experiment.py reach the stack from outside) ---
PRESIDIO_PORT=5002
MOCK_LLM_PORT=5005
PROXY_PORT=8090

# --- PrivacyProxy image ---
# Use a FIXED tag/SHA (not the floating "dev" tag) so a run stays reproducible
# and does not silently change behaviour when someone pushes to "dev".
# Tags are full commit hashes WITHOUT a prefix (e.g. 3d11c4f0d58ffd8ab4fcc83d08a02b207e57d17e),
# not "sha-<hash>". Available tags:
# https://github.com/plueschtierbaum/PrivacyProxy/pkgs/container/privacyproxy
# (ghcr.io is currently private -> run `docker login ghcr.io` first with a
#  CLASSIC PAT that has at least the "read:packages" scope)
PRIVACYPROXY_IMAGE_TAG=<set-me-to-a-commit-sha>

# --- Experiment parameters (read by experiment.py) ---
SAMPLE_SIZE=500        # samples PER LANGUAGE; lower (e.g. 50) for a quick test
LANGUAGES=de,en        # which languages to test

# Optional: Hugging Face token to avoid rate limits when downloading the dataset
# HF_TOKEN=
