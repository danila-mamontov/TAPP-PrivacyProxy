# Application
APP_PORT=8080
BIND_HOST=127.0.0.1

# LLM
# Note: BaseUrl must point at the OpenAI-compatible "v1" root (with trailing
# slash), since requests are sent to "<LLM_BASE_URL>chat/completions".
LLM_BASE_URL=http://ollama:11434/v1/
LLM_API_KEY=ollama
LLM_MODEL=llama3

# Presidio (service name on the shared "privacyproxy-net" docker network,
# see /Presidio/docker-compose.yml)
PRESIDIO_URL=http://presidio-analyzer:3000

# Mapping
MAPPING_TTL=30
