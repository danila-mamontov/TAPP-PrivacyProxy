# Application
APP_PORT=8080
BIND_HOST=127.0.0.1

# Image tag to pull, see "Image tags" in the README
# (latest = current main, stable = alias of latest, dev = current dev, <sha> = pinned commit)
PRIVACYPROXY_IMAGE_TAG=latest

# LLM
LLM_BASE_URL=http://ollama:11434
LLM_API_KEY=ollama
LLM_MODEL=llama3

# Presidio (service name on the shared "privacyproxy-net" docker network,
# see /Presidio/docker-compose.yml)
PRESIDIO_URL=http://presidio-analyzer:3000

# Mapping
MAPPING_TTL=30
