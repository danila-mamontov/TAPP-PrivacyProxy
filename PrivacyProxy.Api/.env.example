# Application
APP_PORT=8080
BIND_HOST=127.0.0.1

# Host port the WebUI is exposed on (container listens on 8080)
WEBUI_PORT=8081

# Image tag to pull (shared by API and WebUI), see "Image tags" in the README
# (latest = current main, stable = alias of latest, dev = current dev, <sha> = pinned commit)
PRIVACYPROXY_IMAGE_TAG=latest

# LLM
# Note: BaseUrl must point at the OpenAI-compatible "v1" root (with trailing
# slash), since requests are sent to "<LLM_BASE_URL>chat/completions".
# For an LLM running on the Docker host (e.g. an SSH-tunnelled Ollama), use
# http://host.docker.internal:11434/v1/
LLM_BASE_URL=http://ollama:11434/v1/
LLM_API_KEY=ollama
LLM_MODEL=llama3

# Presidio (service name on the shared "privacyproxy-net" docker network,
# see /Presidio/docker-compose.yml)
PRESIDIO_URL=http://presidio-analyzer:3000

# Mapping
MAPPING_TTL=30
