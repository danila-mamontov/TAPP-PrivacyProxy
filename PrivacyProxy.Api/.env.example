# Copy this file to ".env" and adjust it. ".env" is gitignored.
# These values feed docker-compose.yml. The Presidio entity types and per-entity
# thresholds live directly in docker-compose.yml (edit them there).

# ---- Image / networking -----------------------------------------------------
# Image tag to pull (shared by API and WebUI). See "Image tags" in the README:
#   latest = current main, stable = alias of latest, dev = current dev, <sha> = pinned commit.
PRIVACYPROXY_IMAGE_TAG=latest

# Host interface the containers are published on (127.0.0.1 = local only).
BIND_HOST=127.0.0.1
# Host port for the API (container always listens on 8080 internally).
APP_PORT=8080
# Host port for the WebUI (container always listens on 8080 internally).
WEBUI_PORT=8081

# ---- Logging ----------------------------------------------------------------
# Serilog minimum level: Verbose, Debug, Information, Warning, Error, Fatal.
# (Per-namespace overrides live in docker-compose.yml.)
LOG_LEVEL=Information

# ---- LLM (upstream OpenAI-compatible provider) ------------------------------
# BaseUrl must be the OpenAI-compatible "v1" root WITH a trailing slash.
# For an LLM on the Docker host (e.g. an SSH-tunnelled Ollama), use host.docker.internal.
LLM_BASE_URL=http://host.docker.internal:11434/v1/
LLM_API_KEY=ollama
LLM_MODEL=llama3

# ---- Presidio ---------------------------------------------------------------
# How the API reaches the Presidio Analyzer. Service name on the shared
# "privacyproxy-net" network (see /Presidio/docker-compose.yml), or a host URL
# like http://172.17.0.1:5002 if Presidio is published on the host.
PRESIDIO_URL=http://presidio-analyzer:3000
# Global confidence floor. Must be <= the smallest per-entity threshold set in
# docker-compose.yml, otherwise the app refuses to start.
PRESIDIO_SCORE_THRESHOLD=0.4

# ---- Mapping ----------------------------------------------------------------
# Sliding TTL (minutes) for placeholder<->original mappings; reset on every use.
MAPPING_TTL=600
